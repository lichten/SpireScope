# Auto-detect text files and normalize line endings
* text=auto

# C# source files
*.cs text eol=crlf
*.csproj text eol=crlf
*.slnx text eol=crlf
*.resx text eol=crlf
*.txt text eol=crlf
*.md text eol=crlf
*.json text eol=crlf
*.gitignore text eol=crlf
*.gitattributes text eol=crlf

# ゲームからの生コピー（LF のまま版固定する）は CRLF 変換の対象外
StS2Shared/Resources/v*/localization/**/*.json text eol=lf

# Mac 版（macos/）は Swift ツールチェーン前提のため全て LF
macos/** text eol=lf
macos/Tests/SpireScopeCoreTests/Fixtures/current_run.save text eol=lf
